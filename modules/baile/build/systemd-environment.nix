{
  pkgs,
  lib,
  config,
  ...
}: let
  cfg-systemd = config.systemd;
  to-env-var = env-var: lib.concatMapStringsSep ":" toString (lib.toList env-var);

  to-systemd-env = env:
    lib.concatLines (lib.mapAttrsToList (name: value: "${name}=\"${to-env-var value}\"") env);
in {
  config = lib.mkIf (cfg-systemd.sessionVariables != {}) {
    build.systemdBaileEnv = pkgs.writeShellScript "systemd-baile-env" (''
        ## Generated by baile

        # Do not edit this file directly.
        # Instead, edit the configuration in `baile.systemd.sessionVariables`.

      ''
      + (to-systemd-env cfg-systemd.sessionVariables));
  };
}
